{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "The seven story sections shown on the website timeline"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order": {
      "type": "integer",
      "required": true,
      "unique": true,
      "min": 1
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "nav_label": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "highlight": {
      "type": "text"
    },
    "body": {
      "type": "text",
      "required": true,
      "maxLength": 20000
    }
  }
}
